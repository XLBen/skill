{
  "context7": {
    "说明": "按库名和版本取最新官方文档，减少编造 API（https://github.com/upstash/context7）",
    "config": {"type": "remote", "url": "https://mcp.context7.com/mcp", "enabled": true}
  },
  "playwright": {
    "说明": "浏览器自动化（https://github.com/microsoft/playwright-mcp）",
    "config": {"type": "local", "command": ["npx", "-y", "@playwright/mcp@latest"], "enabled": true}
  },
  "computer-use": {
    "说明": "桌面截图与鼠标键盘控制（https://github.com/domdomegg/computer-use-mcp）",
    "config": {"type": "local", "command": ["npx", "-y", "computer-use-mcp"], "enabled": true}
  }
}
