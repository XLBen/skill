# Unity .gitignore 模板 — 复制到 Unity 项目根目录改名为 .gitignore
# 来源: github/gitignore 的 Unity 模板精简版

# 生成目录(可由项目重建)
[Bb]uild/
[Ll]ibrary/
[Tt]emp/
[Oo]bj/
[Ll]ogs/
[Uu]serSettings/
[Mm]emoryCaptures/

# 编辑器自动产物
*.pidb.meta
*.pdb.meta
*.mdb.meta
*.csproj
*.sln
*.suo
*.user
*.userprefs
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db

# Unity 崩溃报告
sysinfo.txt
crashlytics-build.properties

# 打包产物
*.apk
*.aab
*.unitypackage
*.app
*.ipa

# 操作系统
.DS_Store
Thumbs.db
